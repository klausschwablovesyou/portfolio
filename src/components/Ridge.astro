---
/**
 * The edge of a light section, cut as a mountain ridge instead of a straight line, so the
 * paper rises out of (or breaks off into) the 3D terrain behind the dark sections.
 * `top` draws the paper's ridge over the section above, with two thin ridgelines behind it
 * that move at their own parallax speed; `bottom` lets dark peaks rise into the paper.
 * The profiles are generated at build time from the seed, so they are stable between builds.
 */
interface Props {
  edge: 'top' | 'bottom';
  seed?: number;
}
const { edge, seed = 1 } = Astro.props;

const W = 1200;
const H = 100;

function rng(a: number): () => number {
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/** Seeded 1D gradient noise, roughly -1..1: smooth, but with no period, unlike a sine. */
function noise1(r: () => number): (x: number) => number {
  // gradients never near zero: a run of flat ones would leave a long, dead plateau
  const g = Array.from({ length: 256 }, () => (r() < 0.5 ? -1 : 1) * (0.45 + r() * 0.55));
  return (x) => {
    const i = Math.floor(x);
    const t = x - i;
    const a = g[i & 255] * t;
    const b = g[(i + 1) & 255] * (t - 1);
    const s = t * t * t * (t * (t * 6 - 15) + 10);
    return (a + (b - a) * s) * 2;
  };
}

/**
 * Heights in 0..1 (1 = peak) from ridged fractal noise: pointed peaks, round valleys.
 * A slow domain warp spaces the crests unevenly, and a broad swell makes some of them
 * tower over the others, so the skyline never settles into a repeating rhythm.
 */
function profile(s: number, n = 160): number[] {
  const r = rng(s * 7919);
  const base = noise1(r);
  const warp = noise1(r);
  const swell = noise1(r);
  const ox = r() * 100;
  const raw = Array.from({ length: n }, (_, i) => {
    const x = (i / (n - 1)) * 5.5 + ox;
    const q = x + warp(x * 0.45 + 17) * 0.9;
    let y = 0;
    let amp = 1;
    let freq = 1;
    let prev = 1;
    for (let k = 0; k < 5; k++) {
      let v = 1 - Math.abs(base(q * freq + k * 31.7));
      v *= v;
      // finer crests only grow on the shoulders of the larger ones
      y += v * amp * (k ? 0.35 + 0.65 * prev : 1);
      prev = v;
      amp *= 0.48;
      freq *= 2.07;
    }
    return y * (0.45 + 0.55 * (swell(x * 0.3 + 3) * 0.5 + 0.5));
  });
  const min = Math.min(...raw);
  const max = Math.max(...raw);
  return raw.map((v) => (v - min) / (max - min));
}

/** Path of a ridge whose peaks reach `top` and whose valleys reach `bottom` (viewBox units). */
function ridge(s: number, top: number, bottom: number): string {
  const p = profile(s);
  return p
    .map((h, i) => `${i ? 'L' : 'M'}${((i / (p.length - 1)) * W).toFixed(1)},${(bottom - h * (bottom - top)).toFixed(1)}`)
    .join('');
}

const box = `0 0 ${W} ${H}`;
---

<div class:list={['ridge', `ridge-${edge}`]} aria-hidden="true">
  {
    edge === 'top' ? (
      <>
        <svg viewBox={box} preserveAspectRatio="none" data-speed="0.1">
          <path class="r-back" d={ridge(seed + 11, 2, 58)} />
        </svg>
        <svg viewBox={box} preserveAspectRatio="none" data-speed="0.05">
          <path class="r-mid" d={ridge(seed + 5, 20, 76)} />
        </svg>
        <svg viewBox={box} preserveAspectRatio="none">
          <path class="r-fill" d={`${ridge(seed, 38, 96)}L${W},${H + 2}L0,${H + 2}Z`} />
        </svg>
      </>
    ) : (
      <>
        <svg viewBox={box} preserveAspectRatio="none">
          <path class="r-fill" d={`${ridge(seed, 6, 66)}L${W},-2L0,-2Z`} />
        </svg>
        <svg viewBox={box} preserveAspectRatio="none" data-speed="-0.03">
          <path class="r-mid" d={ridge(seed + 5, 58, 98)} />
        </svg>
      </>
    )
  }
</div>
