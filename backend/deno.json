{
  "imports": {
    "@danet/core": "jsr:@danet/core@^2.12.0",
    "@hono/hono": "jsr:@hono/hono@4.6.3",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env src/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-env src/main.ts",
    "build:site": "cd ../site && npm run build",
    "serve": "deno task build:site && deno task start",
    "test": "deno test --allow-read --allow-env tests/",
    "check": "deno check src/main.ts tests/"
  }
}
