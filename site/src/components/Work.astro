---
import type { SiteContent } from '../i18n';
import { workMeta } from '../i18n/shared';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const w = t.work;
---

<section id="work" class="section dark work" aria-labelledby="work-title">
  <div class="wrap">
    <header class="head grid">
      <p class="label rail" data-reveal>{w.kicker}</p>
      <div class="main">
        <h2 id="work-title" class="h2" data-reveal style="--i:1">{w.heading}</h2>
        <p class="lead" data-reveal style="--i:2">{w.intro}</p>
      </div>
    </header>

    <!-- One row per product on small screens; two staggered columns from 1024 px. -->
    <ol class="works" role="list">
      {
        w.cards.map((card, i) => {
          const meta = workMeta[i];
          return (
            <li class="work-row grid" data-reveal data-speed-desktop={i % 2 ? '-0.05' : undefined}>
              <p class="work-years data">{meta.years}</p>
              <div class="work-title">
                <h3 class="h3">
                  {meta.url ? (
                    <a class="work-link" href={meta.url} target="_blank" rel="noopener noreferrer">
                      {card.name}
                      <svg class="icon work-ext" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" />
                      </svg>
                      <span class="sr-only">{w.newTab}</span>
                    </a>
                  ) : (
                    card.name
                  )}
                </h3>
                <p class="byline">
                  <b>{card.company}</b> <span>· {card.role}</span>
                </p>
              </div>
              <div class="work-body">
                <p class="work-sentence">{card.sentence}</p>
                <ul class="tags" role="list">
                  {meta.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
