---
import type { SiteContent } from '../i18n';
import { contact } from '../i18n/shared';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact" class="section dark contact" aria-labelledby="contact-title">
  <div class="wrap contact-wrap">
    <header class="head grid">
      <p class="label rail" data-reveal>{c.kicker}</p>
      <div class="main">
        <h2 id="contact-title" class="contact-heading" data-reveal style="--i:1">{c.heading}</h2>
        <p class="lead" data-reveal style="--i:2">{c.line}</p>
      </div>
    </header>

    <ul class="channels" role="list">
      {
        contact.phone && (
          <li class="channel grid" data-reveal>
            <span class="label rail">{c.labels.phone}</span>
            <span class="channel-value">
              <a href={contact.phone.href}>{contact.phone.display}</a> <em>· {c.phoneNote}</em>
            </span>
          </li>
        )
      }
      <li class="channel grid" data-reveal style="--i:1">
        <span class="label rail">{c.labels.email}</span>
        <span class="channel-value">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </span>
      </li>
      <li class="channel grid" data-reveal style="--i:2">
        <span class="label rail">{c.labels.linkedin}</span>
        <span class="channel-value">
          <a href={contact.linkedin.href} rel="noopener">{contact.linkedin.display}</a>
        </span>
      </li>
      <li class="channel grid" data-reveal style="--i:3">
        <span class="label rail">{c.labels.location}</span>
        <span class="channel-value">
          {c.location} <em>· {c.timezoneNote}</em>
        </span>
      </li>
    </ul>

    <div class="grid">
      <div class="contact-cta main" data-reveal>
        <a class="btn btn-primary" href={contact.cvHref} download hreflang="en" type="application/pdf">
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10"></path></svg>
          {c.cv}
        </a>
        <span class="label">{c.cvNote}</span>
      </div>
    </div>

    <!-- The 3D shuriken follows this element: it is placed by layout only, never transformed. -->
    <div class="shuriken-anchor" data-anchor="shuriken" aria-hidden="true"></div>
  </div>
</section>
