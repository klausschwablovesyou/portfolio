---
import type { SiteContent } from '../i18n';
import { contact } from '../i18n/shared';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact" class="section dark contact" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div class="contact-text">
      <p class="kicker" data-reveal>{c.kicker}</p>
      <h2 id="contact-title" class="contact-heading" data-reveal style="--i:1">{c.heading}</h2>
      <p class="lead" data-reveal style="--i:2">{c.line}</p>

      <ul class="channels" role="list">
        {
          contact.phone && (
            <li data-reveal style="--i:3">
              <span class="ch-label">{c.labels.phone}</span>
              <a href={contact.phone.href}>
                {contact.phone.display} <em>· {c.phoneNote}</em>
              </a>
            </li>
          )
        }
        <li data-reveal style="--i:4">
          <span class="ch-label">{c.labels.email}</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li data-reveal style="--i:5">
          <span class="ch-label">{c.labels.linkedin}</span>
          <a href={contact.linkedin.href} rel="noopener">{contact.linkedin.display}</a>
        </li>
        <li data-reveal style="--i:6">
          <span class="ch-label">{c.labels.location}</span>
          <span>{c.location} <em>· {c.timezoneNote}</em></span>
        </li>
      </ul>

      <div class="contact-cta" data-reveal style="--i:7">
        <a class="btn btn-primary" href={contact.cvHref} download hreflang="en" type="application/pdf">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path></svg>
          {c.cv}
        </a>
        <span class="cv-note">{c.cvNote}</span>
      </div>
    </div>
    <!-- The 3D shuriken follows this element. -->
    <div class="shuriken-anchor" data-anchor="shuriken" aria-hidden="true"></div>
  </div>
</section>
