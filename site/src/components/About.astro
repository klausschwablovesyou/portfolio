---
import { Picture } from 'astro:assets';
import portrait from '../assets/profile-photo.jpg';
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const a = t.about;
// the large mark above the quote: the raised quotation mark of the language
// (English opens a quote with it, Hungarian closes one with it)
const quoteMark = t.locale === 'hu' ? '”' : '“';
---

<section id="about" class="section light about" aria-labelledby="about-title">
  <div class="wrap">
    <header class="head grid">
      <p class="label rail" data-reveal>{a.kicker}</p>
      <h2 id="about-title" class="h2 main" data-reveal style="--i:1">{a.heading}</h2>
    </header>

    <div class="grid about-body">
      <div class="rail about-side">
        <div class="portrait" data-reveal>
          <!-- the photograph drifts a little inside its frame as the page scrolls -->
          <div class="portrait-drift" data-speed="-0.04" data-speed-limit="20">
            <Picture
              src={portrait}
              alt={a.portraitAlt}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 1024px) 340px, (min-width: 720px) 30vw, 60vw"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <div class="main">
        <p class="lead" data-reveal>{a.paragraph}</p>

        <blockquote class="quote" data-reveal>
          <span class="quote-mark" data-speed="-0.08" aria-hidden="true">{quoteMark}</span>
          <p>{a.quote}</p>
          <footer class="label">{a.quoteSource}</footer>
        </blockquote>

        <div class="about-lists">
          <div data-reveal>
            <h3 class="label list-title">{a.leadershipTitle}</h3>
            <ul class="rows" role="list">
              {a.leadership.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div data-reveal style="--i:1">
            <h3 class="label list-title">{a.languagesTitle}</h3>
            <ul class="rows langs" role="list">
              {
                a.languages.map((l) => (
                  <li>
                    <b>{l.name}</b>
                    <span>{l.level}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
