---
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const year = new Date().getFullYear();
const [first, second] = t.hero.nameLines;
---

<footer class="site-footer dark">
  <div class="wrap footer-inner">
    <a class="footer-name" href="#top" aria-label={t.a11y.home}>
      <span aria-hidden="true">{first} <i>{second}</i></span>
    </a>
    <span class="footer-meta data">© {year} · {t.footer.builtWith}</span>
  </div>
</footer>
