---
import type { SiteContent } from '../i18n';
import { axisYears, stacks, timeline } from '../i18n/shared';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const [first, second] = t.hero.nameLines;
const span = timeline.end - timeline.start;
---

<section id="top" class="section dark hero" aria-labelledby="hero-name">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="status label" data-reveal>{t.hero.status}</p>
      <!-- the name: two lines in one style and one colour -->
      <h1 id="hero-name" class="hero-name">
        <span class="name-line" data-reveal style="--i:1">{first}</span>{' '}
        <span class="name-line" data-reveal style="--i:2">{second}</span>
      </h1>
      <p class="hero-role" data-reveal style="--i:3">{t.hero.role}</p>
      <p class="hero-tagline" data-reveal style="--i:3">{t.hero.tagline}</p>
      <p class="hero-pitch" data-reveal style="--i:4" set:html={t.hero.pitch} />
      <div class="hero-cta" data-reveal style="--i:5">
        <a class="btn btn-primary" href="#contact">
          {t.hero.ctaPrimary}
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg>
        </a>
        <a class="link" href="#experience">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <!-- The 3D stack graph follows this element (data-anchor), so it may fade in but never
         move. Its labels are real text: without WebGL they render as a small static chart;
         with WebGL the scene positions them. -->
    <figure class="tower" data-anchor="tower" data-reveal="fade" style="--i:4">
      <ul class="tower-labels" role="list">
        {
          stacks.map((s, i) => (
            <li
              class:list={['tower-label', { now: s.current }]}
              data-tower-label={i}
              data-side={s.current ? 'head' : 'tail'}
              style={`--from:${s.from};--to:${s.to};--t0:${timeline.start};--span:${span}`}
            >
              <span class="tl-bar" aria-hidden="true" />
              <span class="tl-text">
                {s.name} <em>{s.years}</em>
              </span>
            </li>
          ))
        }
        {
          axisYears.map((y) => (
            <li class="tower-year" data-tower-year={y} aria-hidden="true">
              {y}
            </li>
          ))
        }
      </ul>
      <figcaption class="tower-caption label">{t.hero.towerCaption}</figcaption>
    </figure>
  </div>
</section>
