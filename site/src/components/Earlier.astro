---
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const e = t.earlier;
---

<section id="earlier" class="section light earlier" aria-labelledby="earlier-title">
  <div class="wrap">
    <header class="head grid">
      <p class="label rail" data-reveal>{e.kicker}</p>
      <h2 id="earlier-title" class="h2 main" data-reveal style="--i:1">{e.heading}</h2>
    </header>
    <ol class="ledger" role="list">
      {
        e.rows.map((row, i) => (
          <li class="ledger-row grid" data-reveal style={`--i:${i}`}>
            <span class="yr data">{row.years}</span>
            <b class="who">{row.name}</b>
            <span class="what">{row.what}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
