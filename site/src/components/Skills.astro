---
import type { SiteContent } from '../i18n';

interface Props {
  t: SiteContent;
}
const { t } = Astro.props;
const s = t.skills;
---

<section id="skills" class="section light skills" aria-labelledby="skills-title">
  <div class="wrap">
    <header class="head grid">
      <p class="label rail" data-reveal>{s.kicker}</p>
      <h2 id="skills-title" class="h2 main" data-reveal style="--i:1">{s.heading}</h2>
    </header>
    <dl class="kit">
      {
        s.groups.map((g, i) => (
          <div class="kit-group grid" data-reveal style={`--i:${i}`}>
            <dt class="rail label">{g.title}</dt>
            <dd class="main" set:html={g.items} />
          </div>
        ))
      }
    </dl>
  </div>
</section>
