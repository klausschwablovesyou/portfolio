# Only deno.json, README.md, the Docker files, site/ and backend/ are tracked from the root folder
/*
!/.gitignore
!/deno.json
!/README.md
!/Dockerfile
!/docker-compose.yml
!/docker-compose.local.yml
!/.dockerignore
!/site/
!/backend/

# environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/
